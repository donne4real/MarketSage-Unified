# --- Market Data Sources (optional; yfinance works out of the box as fallback) ---
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here
TWELVE_DATA_KEY=your_twelve_data_key_here
# Source priority: av_first | td_first | yf_first
DATA_SOURCE_ORDER=yf_first
CACHE_TTL_HOURS=24

# --- SEC EDGAR (required by SEC fair-access policy) ---
SEC_USER_AGENT=MarketSageUnified research@example.com

# --- AI Research Assistant (optional; deterministic offline brief works without keys) ---
# Provider: auto | anthropic | gemini | openai
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=your_anthropic_key_here
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=your_openai_key_here
